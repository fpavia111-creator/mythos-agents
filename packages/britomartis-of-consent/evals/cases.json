{
  "suite": "britomartis-of-consent",
  "root": "..",
  "data_note": "Fictional bakery pages, hand-written HAR captures (first visit, after reject, a visit with Global Privacy Control on), an earlier inventory snapshot and a fictional cookie policy in ../fixtures. Deterministic; no model and no network are used.",
  "cases": [
    {"id": "planted-gaps", "tool": "britomartis_inventory", "args": {"site": "fixtures/site", "base_url": "https://www.example.com", "har_first_visit": "fixtures/har/first-visit.har", "har_after_reject": "fixtures/har/after-reject.har", "declared": "fixtures/declared.json"}, "expect": {"status": "executed", "contains": ["nonessential_before_consent", "nonessential_after_reject", "claim_contradicted", "samesite_none_insecure", "undeclared_cookie", "ungated_tracker_script", "no_consent_mechanism", "declared_not_seen"], "equals": {"result.issues": 25, "result.by_severity.error": 11, "result.cookies.length": 7, "result.third_parties.length": 6}}},
    {"id": "guesses-are-labelled-and-no-compliance-claim", "tool": "britomartis_inventory", "args": {"site": "fixtures/site", "base_url": "https://www.example.com", "har_first_visit": "fixtures/har/first-visit.har", "declared": "fixtures/declared.json"}, "expect": {"contains": ["known_list (guess)", "not a compliance finding", "never says a site is GDPR, CCPA/CPRA or ePrivacy compliant"]}},
    {"id": "gated-script-not-flagged", "tool": "britomartis_inventory", "args": {"site": "fixtures/site", "base_url": "https://www.example.com"}, "expect": {"not_contains": ["\"subject\":\"host connect.facebook.net\",\"detail\":\"Loaded directly", "inline Meta Pixel"]}},
    {"id": "drafts-auto-with-markers", "tool": "britomartis_draft_policy_table", "mode": "auto", "auto_actions": ["britomartis_draft_policy_table"], "args": {"site": "fixtures/site", "base_url": "https://www.example.com", "har_first_visit": "fixtures/har/first-visit.har", "declared": "fixtures/declared.json", "out_dir": "mythos-out/eval"}, "expect": {"status": "executed", "contains": ["[TO CONFIRM] marker(s)", "Nothing was published."]}},
    {"id": "publish-stays-one-click-in-auto", "tool": "britomartis_request_publish", "mode": "auto", "args": {"proposal": "x.json", "proposal_sha256": "0"}, "expect": {"status": "needs_approval", "contains": ["production_deploy stays one-click"]}},
    {"id": "never-changes-live-site", "tool": "deploy_site", "mode": "auto", "args": {}, "expect": {"status": "blocked", "contains": ["never changes the live site"]}},
    {"id": "needs-some-input", "tool": "britomartis_inventory", "args": {}, "expect": {"status": "error", "contains": ["give a site folder, a HAR capture, or both"]}},
    {"id": "gpc-signal-ignored", "tool": "britomartis_inventory", "args": {"base_url": "https://www.example.com", "har_gpc": "fixtures/har/gpc-visit.har"}, "expect": {"status": "executed", "contains": ["gpc_signal_ignored", "Sec-GPC: 1", "a person decides"], "equals": {"result.gpc.captures_with_signal": ["gpc_visit"]}, "not_contains": ["is GDPR compliant", "is CCPA compliant"]}},
    {"id": "vendor-matches-cite-list-version", "tool": "britomartis_inventory", "args": {"base_url": "https://www.example.com", "har_first_visit": "fixtures/har/first-visit.har", "declared": "fixtures/declared.json"}, "expect": {"status": "executed", "contains": ["a guess from britomartis-vendor-list v2026.11.0", "\"vendor_list\":\"britomartis-vendor-list v2026.11.0\"", "known_list (guess)"]}},
    {"id": "diff-since-last-scan", "tool": "britomartis_diff_inventory", "args": {"previous": "fixtures/inventory-previous.json", "base_url": "https://www.example.com", "har_first_visit": "fixtures/har/first-visit.har", "har_after_reject": "fixtures/har/after-reject.har", "declared": "fixtures/declared.json"}, "expect": {"status": "executed", "contains": ["new cookie(s)", "__stripe_mid", "js.stripe.com", "not a compliance finding"], "equals": {"result.new_cookies.length": 1, "result.new_hosts.length": 1}}},
    {"id": "report-html-and-hash", "tool": "britomartis_write_report", "args": {"site": "fixtures/site", "base_url": "https://www.example.com", "har_first_visit": "fixtures/har/first-visit.har", "har_after_reject": "fixtures/har/after-reject.har", "declared": "fixtures/declared.json", "out_dir": "mythos-out/eval-report"}, "expect": {"status": "executed", "contains": ["consent-audit.html", "inventory.json"], "matches": ["\"output_sha256\":\"[0-9a-f]{64}\""]}},
    {"id": "declared-policy-schema-errors", "tool": "britomartis_inventory", "args": {"base_url": "https://www.example.com", "har_first_visit": "fixtures/har/first-visit.har", "declared": "fixtures/har/first-visit.har"}, "expect": {"status": "error", "contains": ["is not a valid declared_policy", "/log is not an allowed property", "/source is required"]}},
    {"id": "diff-needs-previous", "tool": "britomartis_diff_inventory", "args": {"base_url": "https://www.example.com"}, "expect": {"status": "error", "contains": ["invalid arguments: /previous is required"]}}
  ]
}
