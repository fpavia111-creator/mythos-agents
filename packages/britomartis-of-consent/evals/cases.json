{
  "suite": "britomartis-of-consent",
  "root": "..",
  "data_note": "Fictional bakery pages, two hand-written HAR captures and a fictional cookie policy in ../fixtures. Deterministic; no model and no network are used.",
  "cases": [
    { "id": "planted-gaps", "tool": "britomartis_inventory", "args": { "site": "fixtures/site", "base_url": "https://www.example.com", "har_first_visit": "fixtures/har/first-visit.har", "har_after_reject": "fixtures/har/after-reject.har", "declared": "fixtures/declared.json" },
      "expect": { "status": "executed", "contains": ["nonessential_before_consent", "nonessential_after_reject", "claim_contradicted", "samesite_none_insecure", "undeclared_cookie", "ungated_tracker_script", "no_consent_mechanism", "declared_not_seen"], "equals": { "result.issues": 25, "result.by_severity.error": 11, "result.cookies.length": 7, "result.third_parties.length": 6 } } },
    { "id": "guesses-are-labelled-and-no-compliance-claim", "tool": "britomartis_inventory", "args": { "site": "fixtures/site", "base_url": "https://www.example.com", "har_first_visit": "fixtures/har/first-visit.har", "declared": "fixtures/declared.json" }, "expect": { "contains": ["known_list (guess)", "not a compliance finding", "never says a site is GDPR, CCPA/CPRA or ePrivacy compliant"] } },
    { "id": "gated-script-not-flagged", "tool": "britomartis_inventory", "args": { "site": "fixtures/site", "base_url": "https://www.example.com" }, "expect": { "not_contains": ["\"subject\":\"host connect.facebook.net\",\"detail\":\"Loaded directly", "inline Meta Pixel"] } },
    { "id": "drafts-auto-with-markers", "tool": "britomartis_draft_policy_table", "mode": "auto", "auto_actions": ["britomartis_draft_policy_table"], "args": { "site": "fixtures/site", "base_url": "https://www.example.com", "har_first_visit": "fixtures/har/first-visit.har", "declared": "fixtures/declared.json", "out_dir": "mythos-out/eval" }, "expect": { "status": "executed", "contains": ["[TO CONFIRM] marker(s)", "Nothing was published."] } },
    { "id": "publish-stays-one-click-in-auto", "tool": "britomartis_request_publish", "mode": "auto", "args": { "proposal": "x.json", "proposal_sha256": "0" }, "expect": { "status": "needs_approval", "contains": ["production_deploy stays one-click"] } },
    { "id": "never-changes-live-site", "tool": "deploy_site", "mode": "auto", "args": {}, "expect": { "status": "blocked", "contains": ["never changes the live site"] } },
    { "id": "needs-some-input", "tool": "britomartis_inventory", "args": {}, "expect": { "status": "error", "contains": ["give a site folder, a HAR capture, or both"] } }
  ]
}
