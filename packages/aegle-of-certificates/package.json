{
  "name": "aegle-of-certificates",
  "version": "0.1.0",
  "description": "Aegle of Certificates: an MCP agent that tracks expiry for TLS certificates, domains, licences and vendor certificates of insurance from CSV inventories, checks COIs against your written requirements and drafts chase emails. Paid renewals, production changes and sends are always one human click.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "aegle-of-certificates": "bin/aegle-of-certificates.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/aegle-of-certificates.js demo",
    "eval": "node bin/aegle-of-certificates.js eval"
  },
  "dependencies": {
    "mythos-agent-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/mythos-agents.git",
    "directory": "packages/aegle-of-certificates"
  },
  "homepage": "https://github.com/fpavia111-creator/mythos-agents/tree/main/packages/aegle-of-certificates#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/mythos-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "certificates",
