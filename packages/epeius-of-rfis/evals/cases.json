{
  "suite": "epeius-of-rfis",
  "root": "..",
  "data_note": "Fictional project, index, text extracts and logs in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {"id": "log-flags", "tool": "epeius_review_log", "args": {"documents": "fixtures/documents.csv", "rfis": "fixtures/rfis.csv", "submittals": "fixtures/submittals.csv", "as_of": "2026-11-14"}, "expect": {"contains": ["superseded_reference", "unknown_reference", "missing_references", "possible_duplicate", "review_overdue", "overdue_submission", "resubmit_pending", "current is rev 3"], "equals": {"result.rfis": 5, "result.open": 3, "result.overdue": 1, "result.submittal_issues": 3}}},
    {"id": "draft-cites-extracts", "tool": "epeius_draft_rfi", "mode": "auto", "auto_actions": ["epeius_draft_rfi"], "args": {"documents": "fixtures/documents.csv", "rfis": "fixtures/rfis.csv", "subject": "Closer at exam room doors", "question": "Confirm closer mounting side at door type D3 with HW-4.", "references": ["A-501", "08 71 00 2.3.B"], "search": ["D3", "HW-4"], "project": "P", "to": "Architect", "from": "Pat", "needed_by": "2026-11-21", "cost_impact": "None", "schedule_impact": "None", "out_dir": "mythos-out/eval"}, "expect": {"status": "executed", "contains": ["RFI 006 drafted with 0 open marker(s). Nothing was sent."]}},
    {"id": "draft-marks-gaps", "tool": "epeius_draft_rfi", "mode": "auto", "auto_actions": ["epeius_draft_rfi"], "args": {"documents": "fixtures/documents.csv", "subject": "x", "question": "y", "references": ["A-201 rev 2", "M-401"], "out_dir": "mythos-out/eval2"}, "expect": {"status": "executed", "contains": ["MISSING REFERENCE", "CHECK REVISION", "TO CONFIRM"]}},
    {"id": "send-stays-one-click-in-auto", "tool": "epeius_request_send", "mode": "auto", "args": {"draft": "x.md", "draft_sha256": "0", "to": "Architect"}, "expect": {"status": "needs_approval", "contains": ["binding_send stays one-click"]}},
    {"id": "never-sends", "tool": "send_email", "mode": "auto", "args": {}, "expect": {"status": "blocked", "contains": ["never sends"]}},
    {"id": "draft-needs-a-question", "tool": "epeius_draft_rfi", "mode": "auto", "auto_actions": ["epeius_draft_rfi"], "args": {"documents": "fixtures/documents.csv", "subject": "x"}, "expect": {"status": "error", "contains": ["question is required"]}},
    {"id": "ball-in-court-aging", "tool": "epeius_ball_in_court", "args": {"documents": "fixtures/documents.csv", "rfis": "fixtures/rfis.csv", "submittals": "fixtures/submittals.csv", "as_of": "2026-11-14"}, "expect": {"status": "executed", "contains": ["First to chase: RFI 002 with Architect: response 18 day(s) overdue"], "equals": {"result.open_items": 6, "result.parties.0.party": "Architect", "result.parties.0.overdue": 2, "result.parties.0.31+": 1}, "length": {"result.parties": 3}}},
    {"id": "log-diff-week-over-week", "tool": "epeius_diff_logs", "args": {"previous_rfis": "fixtures/rfis-previous.csv", "rfis": "fixtures/rfis.csv", "as_of": "2026-11-14"}, "expect": {"status": "executed", "contains": ["6 change(s) from 2026-11-07 to 2026-11-14: 2 new, 1 closed"], "equals": {"result.due_changed.0.rfi_no": "003"}}},
    {"id": "title-block-index", "tool": "epeius_index_title_blocks", "args": {"folder": "fixtures/titleblocks", "documents": "fixtures/documents.csv", "out_dir": "mythos-out/eval-tb"}, "expect": {"status": "executed", "contains": ["5 title block(s) read: 1 new sheet(s), 1 newer than the index, 1 unreadable", "your index was not changed"], "matches": ["\"output_sha256\":\"[0-9a-f]{64}\""]}},
    {"id": "transmittal-cites-index-only", "tool": "epeius_draft_transmittal", "mode": "auto", "auto_actions": ["epeius_draft_transmittal"], "args": {"documents": "fixtures/documents.csv", "items": ["A-201", "A-501", "M-401"], "subject": "Door package", "purpose": "For construction", "project": "P", "to": "GC", "from": "Architect", "date": "2026-11-14", "transmittal_no": "TR-009", "out_dir": "mythos-out/eval-tr"}, "expect": {"status": "executed", "contains": ["Transmittal TR-009 drafted with 2 indexed document(s) and 1 open marker(s) (MISSING REFERENCE). Nothing was sent."]}},
    {"id": "transmittal-draft-needs-a-yes", "tool": "epeius_draft_transmittal", "args": {"documents": "fixtures/documents.csv", "items": ["A-201"], "subject": "x", "out_dir": "mythos-out/eval-tr2"}, "expect": {"status": "needs_approval"}},
    {"id": "transmittal-send-refused-with-markers", "tool": "epeius_request_send", "mode": "auto", "approve": "Pat Eval (fictional)", "args": {"draft": "mythos-out/eval-tr/drafts/TR-009.md", "draft_sha256": "2f61ca2c5ceefa45497e249ee90cd65912413594327e239c6e7547ded950c33b", "to": "GC"}, "expect": {"status": "error", "contains": ["open marker(s) in the draft", "[MISSING REFERENCE"]}},
    {"id": "report-has-output-hash", "tool": "epeius_write_log_report", "args": {"documents": "fixtures/documents.csv", "rfis": "fixtures/rfis.csv", "submittals": "fixtures/submittals.csv", "previous_rfis": "fixtures/rfis-previous.csv", "as_of": "2026-11-14", "out_dir": "mythos-out/eval-report"}, "expect": {"status": "executed", "contains": ["rfi-due-dates.ics", "ball-in-court.csv", "rfi-log-diff.md", "6 change(s) since 2026-11-07"], "matches": ["\"output_sha256\":\"[0-9a-f]{64}\""]}},
    {"id": "transmittal-bad-purpose-rejected", "tool": "epeius_draft_transmittal", "mode": "auto", "auto_actions": ["epeius_draft_transmittal"], "args": {"documents": "fixtures/documents.csv", "items": ["A-201"], "subject": "x", "purpose": "Because"}, "expect": {"status": "error", "contains": ["invalid arguments: /purpose"]}}
  ]
}
