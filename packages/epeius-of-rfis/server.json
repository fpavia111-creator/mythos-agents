{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fpavia111-creator/epeius-of-rfis",
  "title": "Epeius of RFIs",
  "description": "An MCP agent that reviews a construction RFI and submittal log against your drawing and spec…",
  "version": "0.2.0",
  "repository": {
    "url": "https://github.com/fpavia111-creator/mythos-agents",
    "source": "github",
    "subfolder": "packages/epeius-of-rfis"
  },
  "websiteUrl": "https://mythosmachines.com/",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "epeius-of-rfis",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Folder holding the exports this agent may read and write (it cannot reach outside it)",
          "isRequired": true,
          "format": "filepath",
          "valueHint": "exports_folder"
        }
      ]
    }
  ]
}
