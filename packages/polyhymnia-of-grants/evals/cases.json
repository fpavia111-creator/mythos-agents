{
 "suite": "polyhymnia-of-grants",
 "root": "..",
 "data_note": "Fictional programs, funders, budgets and evidence in ../fixtures. Deterministic checks; no model is called.",
 "cases": [
  {
   "id": "deadlines",
   "tool": "polyhymnia_deadlines",
   "args": {
    "grants": "fixtures/grants.csv",
    "as_of": "2026-11-14"
   },
   "expect": {
    "equals": {
     "result.items.0.grant_id": "G2",
     "result.items.0.status": "overdue",
     "result.items.1.status": "due_soon",
     "result.items.3.status": "submitted"
    }
   }
  },
  {
   "id": "review-gaps",
   "tool": "polyhymnia_review",
   "args": {
    "grants": "fixtures/grants.csv",
    "budget": "fixtures/budget.csv",
    "outcomes": "fixtures/outcomes.csv",
    "as_of": "2026-11-14"
   },
   "expect": {
    "contains": [
     "over_budget",
     "behind_pace",
     "budget_total_differs_from_award",
     "missing_actual",
     "missing_evidence",
     "evidence_not_found",
     "below_target"
    ],
    "equals": {
     "result.open_items": 13,
     "result.overdue": 1
    }
   }
  },
  {
   "id": "evidence-found-when-present",
   "tool": "polyhymnia_review",
   "args": {
    "grants": "fixtures/grants.csv",
    "outcomes": "fixtures/outcomes.csv",
    "as_of": "2026-11-14"
   },
   "expect": {
    "contains": [
     "\"evidence\":\"evidence/g1-enrollment.csv\",\"flags\":[]"
    ]
   }
  },
  {
   "id": "packet-auto-when-opted-in",
   "tool": "polyhymnia_build_packet",
   "mode": "auto",
   "auto_actions": [
    "polyhymnia_build_packet"
   ],
   "args": {
    "grants": "fixtures/grants.csv",
    "budget": "fixtures/budget.csv",
    "outcomes": "fixtures/outcomes.csv",
    "as_of": "2026-11-14",
    "out_dir": "mythos-out/eval"
   },
   "expect": {
    "status": "executed",
    "contains": [
     "3 draft packet(s) written",
     "Nothing was submitted."
    ]
   }
  },
  {
   "id": "submission-stays-one-click-in-auto",
   "tool": "polyhymnia_request_submission",
   "mode": "auto",
   "args": {
    "grant_id": "G1",
    "packet": "x.md"
   },
   "expect": {
    "status": "needs_approval",
    "contains": [
     "binding_send stays one-click"
    ]
   }
  },
  {
   "id": "never-submits",
   "tool": "funder_portal_submit",
   "mode": "auto",
   "args": {},
   "expect": {
    "status": "blocked"
   }
  },
  {
   "id": "variance-explanation-markers",
   "tool": "polyhymnia_variance",
   "args": {
    "grants": "fixtures/grants.csv",
    "budget": "fixtures/budget.csv",
    "as_of": "2026-11-14"
   },
   "expect": {
    "contains": [
     "[EXPLAIN VARIANCE — +2,232.97 (+32.1%) vs expected by now]",
     "projected_underspend"
    ],
    "equals": {
     "result.lines_needing_explanation": 4
    }
   }
  },
  {
   "id": "variance-threshold-amount",
   "tool": "polyhymnia_variance",
   "args": {
    "grants": "fixtures/grants.csv",
    "budget": "fixtures/budget.csv",
    "as_of": "2026-11-14",
    "grant_id": "G1",
    "variance_amount": 3000
   },
   "expect": {
    "equals": {
     "result.lines_needing_explanation": 1
    }
   }
  },
  {
   "id": "template-check-gaps",
   "tool": "polyhymnia_template_check",
   "args": {
    "grants": "fixtures/grants.csv",
    "budget": "fixtures/budget.csv",
    "outcomes": "fixtures/outcomes.csv",
    "as_of": "2026-11-14",
    "template": "fixtures/templates/lakeside-interim.json",
    "grant_id": "G1"
   },
   "expect": {
    "contains": [
     "attachment_missing",
     "variance_explanations_needed",
     "\"state\":\"to_write\""
    ],
    "length": {
     "result.grants.0.gaps": 2
    }
   }
  },
  {
   "id": "template-typo-fails",
   "tool": "polyhymnia_template_check",
   "args": {
    "grants": "fixtures/grants.csv",
    "budget": "fixtures/budget.csv",
    "outcomes": "fixtures/outcomes.csv",
    "as_of": "2026-11-14",
    "template": "evals/bad-template.json"
   },
   "expect": {
    "status": "error",
    "contains": [
     "/sections/0/requried is not an allowed property"
    ]
   }
  },
  {
   "id": "packet-follows-template",
   "tool": "polyhymnia_build_packet",
   "mode": "auto",
   "auto_actions": [
    "polyhymnia_build_packet"
   ],
   "args": {
    "grants": "fixtures/grants.csv",
    "budget": "fixtures/budget.csv",
    "outcomes": "fixtures/outcomes.csv",
    "as_of": "2026-11-14",
    "grant_id": "G1",
    "template": "fixtures/templates/lakeside-interim.json",
    "out_dir": "mythos-out/eval-template"
   },
   "expect": {
    "status": "executed",
    "contains": [
     "following template \\\"lakeside-interim\\\" (2 template gap(s))",
     "Nothing was submitted."
    ]
   }
  },
  {
   "id": "calendar-ics",
   "tool": "polyhymnia_calendar",
   "args": {
    "grants": "fixtures/grants.csv",
    "as_of": "2026-11-14",
    "out_dir": "mythos-out/eval"
   },
   "expect": {
    "status": "executed",
    "equals": {
     "result.events": 5
    },
    "matches": [
     "\"output_sha256\":\"[0-9a-f]{64}\""
    ]
   }
  },
  {
   "id": "evidence-pack-asks",
   "tool": "polyhymnia_evidence_pack",
   "args": {
    "grants": "fixtures/grants.csv",
    "budget": "fixtures/budget.csv",
    "outcomes": "fixtures/outcomes.csv",
    "as_of": "2026-11-14",
    "grant_id": "G1"
   },
   "expect": {
    "status": "needs_approval",
    "decision": "ask"
   }
  },
  {
   "id": "evidence-pack-blocked-in-review",
   "tool": "polyhymnia_evidence_pack",
   "mode": "review",
   "args": {
    "grants": "fixtures/grants.csv",
    "budget": "fixtures/budget.csv",
    "outcomes": "fixtures/outcomes.csv",
    "as_of": "2026-11-14",
    "grant_id": "G2"
   },
   "expect": {
    "status": "blocked"
   }
  }
 ]
}
