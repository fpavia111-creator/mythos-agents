{
  "suite": "hesperides-of-inventory",
  "root": "..",
  "data_note": "Fictional counts, stock and movements in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {"id": "statuses", "tool": "hesperides_compare", "args": {"counts": "fixtures/counts.csv", "on_hand": "fixtures/on-hand.csv", "transactions": "fixtures/transactions.csv", "snapshot_at": "2026-11-13"}, "expect": {"contains": ["confirmed_by_recount", "possible_uom_error", "recount_differs", "negative_system_qty", "not_in_system", "explained_by_timing", "PO-7781"], "equals": {"result.match": 1, "result.within_tolerance": 1, "result.recount_needed": 1, "result.investigate": 4, "result.not_counted": 1, "result.net_variance_value": -511.6}}},
    {"id": "no-transactions-no-timing", "tool": "hesperides_compare", "args": {"counts": "fixtures/counts.csv", "on_hand": "fixtures/on-hand.csv"}, "expect": {"not_contains": ["\"status\":\"explained_by_timing\""], "equals": {"result.explained_by_timing": 0, "result.recount_needed": 2}}},
    {"id": "draft-auto-when-opted-in", "tool": "hesperides_draft_adjustments", "mode": "auto", "auto_actions": ["hesperides_draft_adjustments"], "args": {"counts": "fixtures/counts.csv", "on_hand": "fixtures/on-hand.csv", "transactions": "fixtures/transactions.csv", "snapshot_at": "2026-11-13", "out_dir": "mythos-out/eval"}, "expect": {"status": "executed", "contains": ["2 adjustment line(s) drafted (net -258.00); 6 held for recount or investigation; 2 without a reason code. Nothing was posted."]}},
    {"id": "post-stays-one-click-in-auto", "tool": "hesperides_request_post", "mode": "auto", "args": {"batch": "x.json", "batch_sha256": "0"}, "expect": {"status": "needs_approval", "contains": ["move_money stays one-click"]}},
    {"id": "never-posts-to-erp", "tool": "erp_post_adjustment", "mode": "auto", "args": {}, "expect": {"status": "blocked", "contains": ["never posts to an ERP"]}},
    {"id": "needs-counts", "tool": "hesperides_compare", "args": {"on_hand": "fixtures/on-hand.csv"}, "expect": {"status": "error", "contains": ["counts is required"]}},
    {"id": "lot-variance-and-mixup", "tool": "hesperides_compare", "args": {"counts": "fixtures/counts-lots.csv", "on_hand": "fixtures/on-hand-lots.csv", "uom_table": "fixtures/uom-table.json"}, "expect": {"contains": ["lot_mixup", "serial_qty_over_one", "L2601", "net to 0"], "equals": {"result.lots": 6, "result.not_counted": 1, "result.match": 2}}},
    {"id": "uom-table-converts-and-explains", "tool": "hesperides_compare", "args": {"counts": "fixtures/counts-lots.csv", "on_hand": "fixtures/on-hand-lots.csv", "uom_table": "fixtures/uom-table.json"}, "expect": {"contains": ["Counted 2 CS × 12 = 24 EA", "the CS→EA factor for CORD-3 in your conversion table"]}},
    {"id": "abc-count-plan", "tool": "hesperides_count_plan", "args": {"on_hand": "fixtures/on-hand.csv", "count_policy": "fixtures/count-policy.json", "out_dir": "mythos-out/eval-plan"}, "expect": {"status": "executed", "contains": ["A 5 × 6, B 2 × 2, C 2 × 1", "count-plan.ics"], "equals": {"result.count_lines": 36, "result.classes.0.counts_per_item": 6, "result.classes.2.counts_per_item": 1}}},
    {"id": "accuracy-with-change", "tool": "hesperides_accuracy", "args": {"counts": "fixtures/counts.csv", "on_hand": "fixtures/on-hand.csv", "transactions": "fixtures/transactions.csv", "snapshot_at": "2026-11-13", "count_policy": "fixtures/count-policy.json", "previous_counts": "fixtures/counts-prev.csv", "previous_on_hand": "fixtures/on-hand.csv"}, "expect": {"equals": {"result.overall.ira_pct": 25, "result.previous.ira_pct": 62.5, "result.change.ira_pct": -37.5}, "contains": ["WID-200@A-02", "Not an audit opinion"]}},
    {"id": "recount-sheet-written", "tool": "hesperides_write_report", "args": {"counts": "fixtures/counts.csv", "on_hand": "fixtures/on-hand.csv", "out_dir": "mythos-out/eval-report"}, "expect": {"status": "executed", "contains": ["recount-sheet.csv", "blind recount sheet"]}},
    {"id": "uom-table-typo-fails-with-pointer", "tool": "hesperides_compare", "args": {"counts": "fixtures/counts-lots.csv", "on_hand": "fixtures/on-hand-lots.csv", "uom_table": "fixtures/bad-uom-table.json"}, "expect": {"status": "error", "contains": ["/conversions/0/facter is not an allowed property"]}}
  ]
}
