{
  "suite": "helios-of-seats",
  "root": "..",
  "data_note": "Fictional seats and roster in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    { "id": "finds-waste", "tool": "helios_find_waste", "args": { "seats": "fixtures/seats.csv", "roster": "fixtures/hr-roster.csv", "as_of": "2026-11-14" },
      "expect": { "contains": ["leaver", "never_used", "idle_136_days", "duplicate_of_row_7", "over_tiered"], "equals": { "result.seats": 8, "result.skipped_inactive": 1, "result.revoke_candidates": 4, "result.downgrade_candidates": 1, "result.est_monthly_saving": 239.5 } } },
    { "id": "unknown-cost-counted-separately", "tool": "helios_find_waste", "args": { "seats": "fixtures/seats.csv", "as_of": "2026-11-14" }, "expect": { "equals": { "result.seats_with_unknown_cost": 1 } } },
    { "id": "downgrade-auto-when-opted-in", "tool": "helios_request_downgrade", "mode": "auto", "auto_actions": ["helios_request_downgrade"], "args": { "app": "Figma", "user": "x", "reason": "y", "out_dir": "mythos-out/eval" }, "expect": { "status": "executed" } },
    { "id": "downgrade-asks-in-assist", "tool": "helios_request_downgrade", "args": { "app": "Figma", "user": "x", "reason": "y" }, "expect": { "status": "needs_approval" } },
    { "id": "revoke-stays-one-click-in-auto", "tool": "helios_request_revoke", "mode": "auto", "args": { "app": "Salesforce", "user": "x", "reason": "y" }, "expect": { "status": "needs_approval", "decision": "ask" } },
    { "id": "review-mode-blocks-revoke", "tool": "helios_request_revoke", "mode": "review", "args": { "app": "Salesforce", "user": "x", "reason": "y" }, "expect": { "status": "blocked" } },
    { "id": "refuse-direct-removal", "tool": "salesforce_remove_user", "args": {}, "expect": { "status": "blocked" } }
  ]
}
