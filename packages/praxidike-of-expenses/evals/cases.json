{
  "suite": "praxidike-of-expenses",
  "root": "..",
  "data_note": "Fictional reports, receipts and policy in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {"id": "recommendations", "tool": "praxidike_review", "args": {"expenses": "fixtures/expenses.csv", "policy": "fixtures/policy.json", "receipts": "fixtures/receipts"}, "expect": {"contains": ["over_limit", "missing_receipt", "receipt_amount_mismatch", "late_submission", "disallowed_category", "preapproval_missing", "possible_duplicate", "attendees_missing", "§3.1 Meals"], "equals": {"result.approve": 1, "result.approve_with_changes": 1, "result.needs_info": 2, "result.reject": 1, "result.recommended": 799}}},
    {"id": "no-receipt-text-or-card", "tool": "praxidike_review", "args": {"expenses": "fixtures/expenses.csv", "policy": "fixtures/policy.json", "receipts": "fixtures/receipts"}, "expect": {"not_contains": ["Room 214", "4111 1111 1111 1111", "card ending 0000"], "contains": ["•••• 1111", "Not fraud detection"]}},
    {"id": "without-receipts-folder", "tool": "praxidike_review", "args": {"expenses": "fixtures/expenses.csv", "policy": "fixtures/policy.json"}, "expect": {"not_contains": ["receipt_amount_mismatch"], "equals": {"result.needs_info": 2}}},
    {"id": "stage-auto-when-opted-in", "tool": "praxidike_stage_reimbursement", "mode": "auto", "auto_actions": ["praxidike_stage_reimbursement"], "args": {"expenses": "fixtures/expenses.csv", "policy": "fixtures/policy.json", "receipts": "fixtures/receipts", "out_dir": "mythos-out/eval"}, "expect": {"status": "executed", "contains": ["Staged 2 report(s), 799.00 USD; held 3. Nothing was paid."]}},
    {"id": "reimburse-stays-one-click-in-auto", "tool": "praxidike_request_reimbursement", "mode": "auto", "args": {"batch": "x.json", "batch_sha256": "0"}, "expect": {"status": "needs_approval", "contains": ["move_money stays one-click"]}},
    {"id": "never-pays", "tool": "pay_reimbursement", "mode": "auto", "args": {}, "expect": {"status": "blocked", "contains": ["never pays"]}},
    {"id": "policy-needs-a-source", "tool": "praxidike_review", "args": {"expenses": "fixtures/expenses.csv", "policy": "fixtures/expenses.csv"}, "expect": {"status": "error", "contains": ["policy is not valid JSON"]}},
    {"id": "read-receipts-no-text", "tool": "praxidike_read_receipts", "args": {"receipts": "fixtures/receipt-styles"}, "expect": {"status": "executed", "contains": ["Café Lindenhof", "\"total\":45.84", "\"currency\":\"GBP\"", "\"total\":427.14", "\"date\":\"2026-10-28\"", "架空マート 新宿店", "\"currency\":\"KRW\"", "\"total\":22000"], "not_contains": ["Zwischensumme", "Folio", "Visa ending", "お預り", "お釣り"], "length": {"result.receipts": 12}}},
    {"id": "per-diem-and-dated-mileage", "tool": "praxidike_review", "args": {"expenses": "fixtures/expenses-travel.csv", "policy": "fixtures/policy.json"}, "expect": {"contains": ["per diem for Duluth, MN", "rate for 2026-07-01 to open"], "equals": {"result.recommended": 324, "result.approve_with_changes": 2}}},
    {"id": "duplicates-across-periods", "tool": "praxidike_find_duplicates", "args": {"expenses": "fixtures/expenses.csv", "receipts": "fixtures/receipts", "history": "fixtures/history.csv"}, "expect": {"contains": ["identical receipt text after normalising", "H-091/1", "not a finding of wrongdoing"], "not_contains": ["H-092/1"], "equals": {"result.pairs": 4, "result.cross_period": 3}}},
    {"id": "audit-queue-order", "tool": "praxidike_audit_queue", "args": {"expenses": "fixtures/expenses.csv", "policy": "fixtures/policy.json", "receipts": "fixtures/receipts", "history": "fixtures/history.csv"}, "expect": {"equals": {"result.queue.0.report_id": "R-103", "result.queue.2.report_id": "R-101", "result.queue.2.score": 47, "result.high": 2}, "contains": ["possible duplicate of earlier H-090/1"]}},
    {"id": "evidence-pack-hashed", "tool": "praxidike_write_evidence_pack", "args": {"expenses": "fixtures/expenses.csv", "policy": "fixtures/policy.json", "receipts": "fixtures/receipts", "history": "fixtures/history.csv", "out_dir": "mythos-out/eval-evidence"}, "expect": {"status": "executed", "matches": ["\"output_sha256\":\"[0-9a-f]{64}\""], "contains": ["evidence-manifest.json", "10 input file(s) hashed"]}},
    {"id": "policy-typo-fails-with-pointer", "tool": "praxidike_review", "args": {"expenses": "fixtures/expenses.csv", "policy": "fixtures/bad-policy-typo.json"}, "expect": {"status": "error", "contains": ["/recipt_required_over is not an allowed property"]}},
    {"id": "reimburse-after-approval-records-only", "tool": "praxidike_request_reimbursement", "approve": "Kim Controller (fictional)", "args": {"batch": "fixtures/nope.json", "batch_sha256": "1"}, "expect": {"status": "error", "contains": ["batch not found"]}}
  ]
}
