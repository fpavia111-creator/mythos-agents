{
  "suite": "solon-of-clauses",
  "root": "..",
  "data_note": "Fictional MSA ../fixtures/contracts/msa.md and a fictional customer-side playbook. Text matching only; no model and no network are used. Not legal advice.",
  "cases": [
    { "id": "planted-gaps", "tool": "solon_check", "args": { "contract": "fixtures/contracts/msa.md", "playbook": "fixtures/playbook.json" },
      "expect": { "status": "executed", "contains": ["\"status\":\"missing\"", "prohibited_present", "Payment period is 60 days (line 15); your playbook's limit is 45 days.", "Liability cap is 3 months of fees", "return or destroy", "open_placeholder", "broken_cross_reference", "Not legal advice"], "equals": { "result.gaps": 6, "result.counts.present": 3, "result.sections": 10 } } },
    { "id": "citations-have-section-and-line", "tool": "solon_check", "args": { "contract": "fixtures/contracts/msa.md", "playbook": "fixtures/playbook.json" }, "expect": { "contains": ["\"section\":\"4 Term and Renewal\",\"line\":19", "\"section\":\"6 Limitation of Liability\",\"line\":27"] } },
    { "id": "memo-uses-only-playbook-language", "tool": "solon_draft_markup", "mode": "auto", "auto_actions": ["solon_draft_markup"], "args": { "contract": "fixtures/contracts/msa.md", "playbook": "fixtures/playbook.json", "out_dir": "mythos-out/eval" }, "expect": { "status": "executed", "contains": ["[COUNSEL REVIEW]", "Nothing was sent. Not legal advice."] } },
    { "id": "send-stays-one-click-in-auto", "tool": "solon_request_send", "mode": "auto", "args": { "draft": "x.md", "draft_sha256": "0", "to": "x", "reviewed_by": "y" }, "expect": { "status": "needs_approval", "contains": ["binding_send stays one-click"] } },
    { "id": "never-signs", "tool": "e_sign", "mode": "auto", "args": {}, "expect": { "status": "blocked", "contains": ["never signs"] } },
    { "id": "no-docx", "tool": "solon_check", "args": { "contract": "fixtures/playbook.json", "playbook": "fixtures/playbook.json" }, "expect": { "status": "error", "contains": ["export the document as plain text"] } }
  ]
}
