{
  "name": "olympus-of-migration",
  "version": "0.1.0",
  "description": "Olympus of Migration: a domain-specific MCP agent that checks NetSuite/ERP migration export files (CSV/JSON) before go-live and writes a readiness report. Read-only on your data; never approves go-live.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": { "node": ">=20" },
  "main": "src/index.js",
  "exports": { ".": "./src/index.js", "./package.json": "./package.json" },
  "bin": { "olympus-of-migration": "bin/olympus-of-migration.js" },
  "files": ["src", "bin", "fixtures", "evals", "README.md", "LICENSE"],
  "scripts": { "test": "node scripts/run-tests.cjs", "demo": "node bin/olympus-of-migration.js demo", "eval": "node bin/olympus-of-migration.js eval" },
  "dependencies": { "mythos-agent-core": "^0.1.0" },
  "repository": { "type": "git", "url": "git+https://github.com/fpavia111-creator/mythos-agents.git", "directory": "packages/olympus-of-migration" },
  "homepage": "https://github.com/fpavia111-creator/mythos-agents/tree/main/packages/olympus-of-migration#readme",
  "bugs": { "url": "https://github.com/fpavia111-creator/mythos-agents/issues" },
  "keywords": ["mcp", "mcp-server", "netsuite", "erp-migration", "data-migration", "go-live", "ai-agents", "mythos"]
}
