{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fpavia111-creator/olympus-of-migration",
  "title": "Olympus of Migration",
  "description": "A domain-specific MCP agent that checks NetSuite/ERP migration export files (CSV/JSON) before…",
  "version": "0.2.0",
  "repository": {
    "url": "https://github.com/fpavia111-creator/mythos-agents",
    "source": "github",
    "subfolder": "packages/olympus-of-migration"
  },
  "websiteUrl": "https://mythosmachines.com/",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "olympus-of-migration",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Folder holding the exports this agent may read and write (it cannot reach outside it)",
          "isRequired": true,
          "format": "filepath",
          "valueHint": "exports_folder"
        }
      ]
    }
  ]
}
