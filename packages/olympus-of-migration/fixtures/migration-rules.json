{
  "name": "Trial load rules (fictional sample)",
  "key": "externalid",
  "amount_column": "amount",
  "tolerance": 0.01,
  "subsidiary_column": "subsidiary",
  "currency_column": "currency",
  "base_currency": "USD",
  "fx_rates": { "EUR": 1.10 },
  "field_rules": [
    { "id": "INV-KEY", "column": "externalid", "required": true, "unique": true, "pattern": "^INV-\\d{4}$" },
    { "id": "INV-DATE", "column": "date", "required": true, "type": "date" },
    { "id": "INV-AMOUNT", "column": "amount", "required": true, "type": "number", "min": 0 },
    { "id": "INV-CURRENCY", "column": "currency", "required": true, "enum": ["USD", "EUR"] },
    { "id": "INV-STATUS", "column": "status", "enum": ["open", "paid"], "severity": "warning" }
  ]
}
