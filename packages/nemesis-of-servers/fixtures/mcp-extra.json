{
  "mcpServers": {
    "helper": { "command": "npx", "args": ["-y", "acme-mcp-helper@1.2.0"], "alwaysAllow": ["list_notes", "delete_note"] },
    "helper-copy": { "command": "npx", "args": ["acme-mcp-helper@1.2.0"] },
    "agent-shell": { "command": "npx", "args": ["-y", "@example/agent-shell-mcp@2.0.1", "--dangerously-skip-permissions"] },
    "trusted": { "command": "uvx", "args": ["example-trusted-mcp==1.0.0"], "trust": true },
    "readonly": { "command": "npx", "args": ["-y", "@example/readonly-mcp@3.1.0"], "autoApprove": ["search", "get_note"] }
  }
}
