{
  "suite": "daphne-of-pages",
  "root": "..",
  "data_note": "Fictional pages in ../fixtures/site with planted issues. Deterministic checks; no model and no network are used.",
  "cases": [
    { "id": "planted-issues", "tool": "daphne_audit", "args": { "site": "fixtures/site", "base_url": "https://www.example.com" },
      "expect": { "contains": ["broken_link", "broken_anchor", "broken_image", "img_alt_missing", "input_label_missing", "zoom_disabled", "html_lang_missing", "iframe_title_missing", "duplicate_title", "noindex"], "equals": { "result.pages": 4, "result.issues": 25, "result.by_severity.error": 11 } } },
    { "id": "wcag-mapping-and-limits", "tool": "daphne_audit", "args": { "site": "fixtures/site" }, "expect": { "contains": ["\"wcag\":\"1.1.1\"", "\"wcag\":\"1.4.4\"", "not a legal opinion", "External links are listed, not fetched"] } },
    { "id": "ignore-a-check", "tool": "daphne_audit", "args": { "site": "fixtures/site", "ignore": ["canonical_missing", "title_length"] }, "expect": { "not_contains": ["canonical_missing", "title_length"], "equals": { "result.issues": 21 } } },
    { "id": "drafts-auto-when-opted-in", "tool": "daphne_draft_fixes", "mode": "auto", "auto_actions": ["daphne_draft_fixes"], "args": { "site": "fixtures/site", "lang": "en", "out_dir": "mythos-out/eval" }, "expect": { "status": "executed", "contains": ["1 page(s) with mechanical fixes written to proposed/", "Nothing was published."] } },
    { "id": "publish-stays-one-click-in-auto", "tool": "daphne_request_publish", "mode": "auto", "args": { "proposal": "x.json", "proposal_sha256": "0" }, "expect": { "status": "needs_approval", "contains": ["production_deploy stays one-click"] } },
    { "id": "never-deploys", "tool": "deploy_site", "mode": "auto", "args": {}, "expect": { "status": "blocked", "contains": ["never deploys"] } },
    { "id": "missing-site-errors", "tool": "daphne_audit", "args": { "site": "fixtures/nope" }, "expect": { "status": "error", "contains": ["site folder not found"] } }
  ]
}
