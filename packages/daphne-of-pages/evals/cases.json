{
  "suite": "daphne-of-pages",
  "root": "..",
  "data_note": "Fictional pages in ../fixtures/site with planted issues. Deterministic checks; no model and no network are used.",
  "cases": [
    {"id": "planted-issues", "tool": "daphne_audit", "args": {"site": "fixtures/site", "base_url": "https://www.example.com"}, "expect": {"contains": ["broken_link", "broken_anchor", "broken_image", "img_alt_missing", "input_label_missing", "zoom_disabled", "html_lang_missing", "iframe_title_missing", "duplicate_title", "noindex"], "equals": {"result.pages": 4, "result.issues": 25, "result.by_severity.error": 11}}},
    {"id": "wcag-mapping-and-limits", "tool": "daphne_audit", "args": {"site": "fixtures/site"}, "expect": {"contains": ["\"wcag\":\"1.1.1\"", "\"wcag\":\"1.4.4\"", "not a legal opinion", "External links are listed, not fetched"]}},
    {"id": "ignore-a-check", "tool": "daphne_audit", "args": {"site": "fixtures/site", "ignore": ["canonical_missing", "title_length"]}, "expect": {"not_contains": ["canonical_missing", "title_length"], "equals": {"result.issues": 21}}},
    {"id": "contrast-with-selectors", "tool": "daphne_audit", "args": {"site": "fixtures/shop"}, "expect": {"contains": ["\"check\":\"contrast_low\"", "body > main > a.btn-primary", "\"wcag\":\"1.4.3\"", "#999999 on #ffffff"], "equals": {"result.contrast.elements_skipped": 1}}},
    {"id": "aria-and-focus", "tool": "daphne_audit", "args": {"site": "fixtures/shop", "ignore": ["contrast_low"]}, "expect": {"contains": ["aria_role_invalid", "aria_attr_invalid", "aria_value_invalid", "aria_reference_missing", "aria_role_not_focusable", "focusable_in_aria_hidden", "focus_outline_removed", "ul#menu > li > a"], "not_contains": ["contrast_low"]}},
    {"id": "sitemap-robots", "tool": "daphne_audit", "args": {"site": "fixtures/shop", "base_url": "https://shop.example.com"}, "expect": {"contains": ["sitemap_missing_page", "sitemap_dead_url", "sitemap_url_blocked", "robots_blocks_page", "robots_no_sitemap"], "equals": {"result.crawl.checked": true, "result.crawl.sitemap_urls": 4}}},
    {"id": "top-actions-template", "tool": "daphne_audit", "args": {"site": "fixtures/shop", "config": "fixtures/daphne.config.json"}, "expect": {"equals": {"result.top_actions.0.template_likely": true, "result.top_actions.0.check": "contrast_low"}, "length": {"result.top_actions.0.pages": 5}}},
    {"id": "config-schema-error", "tool": "daphne_audit", "args": {"site": "fixtures/shop", "config": "evals/cases.json"}, "expect": {"status": "error", "contains": ["not a valid audit_config", "/suite is not an allowed property"]}},
    {"id": "report-html", "tool": "daphne_write_report", "args": {"site": "fixtures/shop", "out_dir": "mythos-out/eval"}, "expect": {"status": "executed", "contains": ["page-audit.html"], "matches": ["\"output_sha256\":\"[0-9a-f]{64}\""]}},
    {"id": "draft-fixes-diff", "tool": "daphne_draft_fixes", "approve": "Eval Reviewer", "args": {"site": "fixtures/site", "lang": "en", "out_dir": "mythos-out/eval-diff"}, "expect": {"status": "executed", "contains": ["fixes.diff"]}},
    {"id": "drafts-auto-when-opted-in", "tool": "daphne_draft_fixes", "mode": "auto", "auto_actions": ["daphne_draft_fixes"], "args": {"site": "fixtures/site", "lang": "en", "out_dir": "mythos-out/eval"}, "expect": {"status": "executed", "contains": ["1 page(s) with mechanical fixes written to proposed/", "Nothing was published."]}},
    {"id": "publish-stays-one-click-in-auto", "tool": "daphne_request_publish", "mode": "auto", "args": {"proposal": "x.json", "proposal_sha256": "0"}, "expect": {"status": "needs_approval", "contains": ["production_deploy stays one-click"]}},
    {"id": "never-deploys", "tool": "deploy_site", "mode": "auto", "args": {}, "expect": {"status": "blocked", "contains": ["never deploys"]}},
    {"id": "missing-site-errors", "tool": "daphne_audit", "args": {"site": "fixtures/nope"}, "expect": {"status": "error", "contains": ["site folder not found"]}}
  ]
}
