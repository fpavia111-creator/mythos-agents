{
  "name": "augeas-of-masters",
  "version": "0.2.0",
  "mcpName": "io.github.fpavia111-creator/augeas-of-masters",
  "description": "Augeas of Masters: a domain-specific MCP agent that finds likely duplicate vendors or items in master-data exports (CSV/JSON) with explainable match signals, previews field-level merge winners, and applies one approved merge at a time to a copy of the file with an undo log. Never edits your ERP.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "augeas-of-masters": "bin/augeas-of-masters.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/augeas-of-masters.js demo",
    "eval": "node bin/augeas-of-masters.js eval"
  },
  "dependencies": {
    "mythos-agent-core": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/mythos-agents.git",
    "directory": "packages/augeas-of-masters"
  },
  "homepage": "https://github.com/fpavia111-creator/mythos-agents/tree/main/packages/augeas-of-masters#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/mythos-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "master-data",
    "vendor-master",
    "deduplication",
    "netsuite",
    "ai-agents",
    "entity-resolution",
    "survivorship",
    "mythos"
  ]
}
