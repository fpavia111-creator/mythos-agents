{
  "suite": "augeas-of-masters",
  "root": "..",
  "data_note": "Fictional master data in ../fixtures. Deterministic tool-level checks; no model is called.",
  "cases": [
    {
      "id": "finds-acme-by-tax-id",
      "tool": "augeas_find_duplicates",
      "args": {
        "path": "fixtures/vendors.csv",
        "kind": "vendor"
      },
      "expect": {
        "contains": [
          "V100",
          "V101",
          "same tax id"
        ]
      }
    },
    {
      "id": "finds-blue-harbour-spelling",
      "tool": "augeas_find_duplicates",
      "args": {
        "path": "fixtures/vendors.csv",
        "kind": "vendor"
      },
      "expect": {
        "contains": [
          "V103"
        ],
        "equals": {
          "result.clusters": 2
        }
      }
    },
    {
      "id": "different-tax-ids-not-merged",
      "tool": "augeas_find_duplicates",
      "args": {
        "path": "fixtures/vendors.csv",
        "kind": "vendor"
      },
      "expect": {
        "contains": [
          "DIFFERENT tax ids"
        ]
      }
    },
    {
      "id": "items-by-upc",
      "tool": "augeas_find_duplicates",
      "args": {
        "path": "fixtures/items.csv",
        "kind": "item"
      },
      "expect": {
        "equals": {
          "result.clusters": 1
        },
        "contains": [
          "same UPC/part number"
        ]
      }
    },
    {
      "id": "merge-needs-human",
      "tool": "augeas_apply_merge",
      "args": {
        "path": "fixtures/vendors.csv",
        "survivor": "V100",
        "merge": [
          "V101"
        ]
      },
      "expect": {
        "status": "needs_approval"
      }
    },
    {
      "id": "auto-off-by-default",
      "tool": "augeas_apply_merge",
      "mode": "auto",
      "args": {
        "path": "fixtures/vendors.csv",
        "survivor": "V100",
        "merge": [
          "V101"
        ]
      },
      "expect": {
        "status": "needs_approval"
      }
    },
    {
      "id": "refuse-payment-in-auto",
      "tool": "augeas_pay_vendor",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "signals-explain-each-pair",
      "tool": "augeas_find_duplicates",
      "args": {
        "path": "fixtures/vendors.csv",
        "kind": "vendor"
      },
      "expect": {
        "contains": [
          "\"tax\":\"same\"",
          "\"name\":0.99"
        ],
        "equals": {
          "result.blocking": false,
          "result.proposals.0.survivor": "V100"
        }
      }
    },
    {
      "id": "rules-file-is-validated",
      "tool": "augeas_find_duplicates",
      "args": {
        "path": "fixtures/vendors.csv",
        "rules": "fixtures/vendors.csv"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "preview-field-winners",
      "tool": "augeas_merge_preview",
      "args": {
        "path": "fixtures/vendors.csv",
        "survivor": "V102",
        "merge": [
          "V103"
        ],
        "rules": "fixtures/augeas-rules.json"
      },
      "expect": {
        "status": "executed",
        "contains": [
          "\"winner_from\":\"V103\"",
          "\"rule\":\"longest\"",
          "Bank and payment columns are never changed"
        ],
        "length": {
          "result.changes": 1
        }
      }
    },
    {
      "id": "preview-rejects-unknown-id",
      "tool": "augeas_merge_preview",
      "args": {
        "path": "fixtures/vendors.csv",
        "survivor": "V100",
        "merge": [
          "V999"
        ]
      },
      "expect": {
        "status": "error",
        "contains": [
          "V999 not found"
        ]
      }
    },
    {
      "id": "apply-writes-undo-log",
      "tool": "augeas_apply_merge",
      "approve": "Dana Reviewer (fictional)",
      "args": {
        "path": "fixtures/vendors.csv",
        "survivor": "V104",
        "merge": [
          "V106"
        ],
        "out_dir": "mythos-out/eval",
        "output": "eval-vendors.merged.csv"
      },
      "expect": {
        "status": "executed",
        "contains": [
          "undo.jsonl",
          "input file and your ERP were not changed"
        ],
        "matches": [
          "\"output_sha256\":\"[0-9a-f]{64}\""
        ]
      }
    },
    {
      "id": "undo-needs-human",
      "tool": "augeas_undo_merge",
      "args": {
        "copy": "mythos-out/eval/eval-vendors.merged.csv"
      },
      "expect": {
        "status": "needs_approval",
        "decision": "ask"
      }
    },
    {
      "id": "proposals-html",
      "tool": "augeas_propose_merges",
      "args": {
        "path": "fixtures/vendors.csv",
        "out_dir": "mythos-out/eval"
      },
      "expect": {
        "contains": [
          "merge-proposals.html"
        ],
        "equals": {
          "result.clusters": 2
        }
      }
    },
    {
      "id": "japanese-vendor-duplicates",
      "tool": "augeas_find_duplicates",
      "args": {
        "path": "fixtures/intl/ja-vendors.csv"
      },
      "expect": {
        "status": "executed",
        "contains": [
          "same normalized name",
          "V001",
          "V002"
        ],
        "equals": {
          "result.proposals.0.survivor": "V001"
        }
      }
    },
    {
      "id": "mexican-vendors-generic-rfc",
      "tool": "augeas_find_duplicates",
      "args": {
        "path": "fixtures/intl/mx-vendors.csv"
      },
      "expect": {
        "status": "executed",
        "contains": [
          "P001",
          "P002",
          "generic or placeholder tax id"
        ],
        "not_contains": [
          "P003",
          "P005"
        ],
        "equals": {
          "result.proposals.0.survivor": "P001",
          "result.clusters": 1
        }
      }
    }
  ]
}
