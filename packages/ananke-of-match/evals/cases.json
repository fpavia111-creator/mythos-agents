{
  "suite": "ananke-of-match",
  "root": "..",
  "data_note": "Fictional POs, receipts and invoices in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    { "id": "match-finds-exceptions", "tool": "ananke_match", "args": { "pos": "fixtures/pos.csv", "receipts": "fixtures/receipts.csv", "invoices": "fixtures/invoices.csv" },
      "expect": { "contains": ["duplicate_invoice", "price_variance", "qty_over_received", "not_received", "no_po", "po_line_missing"], "equals": { "result.matched": 1, "result.exceptions": 6, "result.est_impact_total": 9180 } } },
    { "id": "price-tolerance-respected", "tool": "ananke_match", "args": { "pos": "fixtures/pos.csv", "receipts": "fixtures/receipts.csv", "invoices": "fixtures/invoices.csv", "price_pct": 10 }, "expect": { "not_contains": ["price_variance"] } },
    { "id": "explain-one", "tool": "ananke_explain_exception", "args": { "pos": "fixtures/pos.csv", "receipts": "fixtures/receipts.csv", "invoices": "fixtures/invoices.csv", "invoice": "INV-2002" }, "expect": { "contains": ["Billed more than received", "Partial receipt"] } },
    { "id": "posting-stays-one-click-in-auto", "tool": "ananke_request_posting", "mode": "auto", "args": { "invoice": "INV-2001", "vendor": "x", "amount": 1, "reason": "y" }, "expect": { "status": "needs_approval", "decision": "ask" } },
    { "id": "review-mode-blocks-posting", "tool": "ananke_request_posting", "mode": "review", "args": { "invoice": "INV-2001", "vendor": "x", "amount": 1, "reason": "y" }, "expect": { "status": "blocked" } },
    { "id": "never-posts-to-erp", "tool": "erp_post_invoice", "mode": "auto", "args": {}, "expect": { "status": "blocked" } }
  ]
}
