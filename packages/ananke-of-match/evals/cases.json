{
  "suite": "ananke-of-match",
  "root": "..",
  "data_note": "Fictional POs, receipts and invoices in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {
      "id": "match-finds-exceptions",
      "tool": "ananke_match",
      "args": {
        "pos": "fixtures/pos.csv",
        "receipts": "fixtures/receipts.csv",
        "invoices": "fixtures/invoices.csv"
      },
      "expect": {
        "contains": [
          "duplicate_invoice",
          "price_variance",
          "qty_over_received",
          "not_received",
          "no_po",
          "po_line_missing"
        ],
        "equals": {
          "result.matched": 1,
          "result.exceptions": 6,
          "result.est_impact_total": 9180
        }
      }
    },
    {
      "id": "price-tolerance-respected",
      "tool": "ananke_match",
      "args": {
        "pos": "fixtures/pos.csv",
        "receipts": "fixtures/receipts.csv",
        "invoices": "fixtures/invoices.csv",
        "price_pct": 10
      },
      "expect": {
        "not_contains": [
          "price_variance"
        ]
      }
    },
    {
      "id": "explain-one",
      "tool": "ananke_explain_exception",
      "args": {
        "pos": "fixtures/pos.csv",
        "receipts": "fixtures/receipts.csv",
        "invoices": "fixtures/invoices.csv",
        "invoice": "INV-2002"
      },
      "expect": {
        "contains": [
          "Billed more than received",
          "Partial receipt"
        ]
      }
    },
    {
      "id": "posting-stays-one-click-in-auto",
      "tool": "ananke_request_posting",
      "mode": "auto",
      "args": {
        "invoice": "INV-2001",
        "vendor": "x",
        "amount": 1,
        "reason": "y"
      },
      "expect": {
        "status": "needs_approval",
        "decision": "ask"
      }
    },
    {
      "id": "review-mode-blocks-posting",
      "tool": "ananke_request_posting",
      "mode": "review",
      "args": {
        "invoice": "INV-2001",
        "vendor": "x",
        "amount": 1,
        "reason": "y"
      },
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "never-posts-to-erp",
      "tool": "erp_post_invoice",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "partial-receipts-several-invoices",
      "tool": "ananke_match",
      "args": {
        "pos": "fixtures/partial-pos.csv",
        "receipts": "fixtures/partial-receipts.csv",
        "invoices": "fixtures/partial-invoices.csv"
      },
      "expect": {
        "contains": [
          "\"receipts\":[\"GRN-958\"]",
          "near_duplicate_invoice"
        ],
        "equals": {
          "result.matched": 3,
          "result.exceptions": 1,
          "result.est_impact_total": 200
        }
      }
    },
    {
      "id": "vendor-tolerance-profile",
      "tool": "ananke_match",
      "args": {
        "pos": "fixtures/pos.csv",
        "receipts": "fixtures/receipts.csv",
        "invoices": "fixtures/invoices.csv",
        "tolerance_profile": "fixtures/tolerances.json"
      },
      "expect": {
        "not_contains": [
          "price_variance"
        ],
        "contains": [
          "vendor profile"
        ],
        "equals": {
          "result.exceptions": 5
        }
      }
    },
    {
      "id": "po-status-grni",
      "tool": "ananke_po_status",
      "args": {
        "pos": "fixtures/partial-pos.csv",
        "receipts": "fixtures/partial-receipts.csv",
        "invoices": "fixtures/partial-invoices.csv"
      },
      "expect": {
        "contains": [
          "received_not_billed"
        ],
        "equals": {
          "result.grni_value_total": 90,
          "result.lines.0.status": "closed"
        }
      }
    },
    {
      "id": "po-status-filter",
      "tool": "ananke_po_status",
      "args": {
        "pos": "fixtures/pos.csv",
        "receipts": "fixtures/receipts.csv",
        "invoices": "fixtures/invoices.csv",
        "po": "PO-4473"
      },
      "expect": {
        "length": {
          "result.lines": 1
        },
        "equals": {
          "result.billed_not_received_total": 7000
        }
      }
    },
    {
      "id": "html-report",
      "tool": "ananke_write_report",
      "args": {
        "pos": "fixtures/partial-pos.csv",
        "receipts": "fixtures/partial-receipts.csv",
        "invoices": "fixtures/partial-invoices.csv",
        "out_dir": "mythos-out/eval"
      },
      "expect": {
        "status": "executed",
        "matches": [
          "\"output_sha256\":\"[0-9a-f]{64}\""
        ],
        "contains": [
          "ap-report.html",
          "ap-po-status.csv"
        ]
      }
    },
    {
      "id": "bad-tolerance-arg-refused",
      "tool": "ananke_match",
      "args": {
        "pos": "fixtures/pos.csv",
        "receipts": "fixtures/receipts.csv",
        "invoices": "fixtures/invoices.csv",
        "price_pct": "two"
      },
      "expect": {
        "status": "error",
        "contains": [
          "invalid arguments"
        ]
      }
    }
  ]
}
