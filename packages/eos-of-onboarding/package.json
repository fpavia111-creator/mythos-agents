{
  "name": "eos-of-onboarding",
  "version": "0.2.0",
  "mcpName": "io.github.fpavia111-creator/eos-of-onboarding",
  "description": "Eos of Onboarding: an MCP agent that tracks onboarding and offboarding checklists for employees, contractors or customers (documents, NDA, W-9, equipment, access, training) from CSV and a JSON template with per-role templates, gives each owner a prioritised action list, checks day-one readiness, and drafts access requests and removals. Granting or revoking access is always one human click.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "eos-of-onboarding": "bin/eos-of-onboarding.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/eos-of-onboarding.js demo",
    "eval": "node bin/eos-of-onboarding.js eval"
  },
  "dependencies": {
    "mythos-agent-core": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/mythos-agents.git",
    "directory": "packages/eos-of-onboarding"
  },
  "homepage": "https://github.com/fpavia111-creator/mythos-agents/tree/main/packages/eos-of-onboarding#readme",
  "bugs": {
