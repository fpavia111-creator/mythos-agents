{
  "suite": "eos-of-onboarding",
  "root": "..",
  "data_note": "Fictional people, template and statuses in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {"id": "status-and-flags", "tool": "eos_status", "args": {"people": "fixtures/people.csv", "template": "fixtures/template.json", "status": "fixtures/status.csv", "as_of": "2026-11-14"}, "expect": {"contains": ["access_before_prereqs", "contractor_no_end_date", "access_after_end", "not_ready_for_start", "C3/slack"], "equals": {"result.people": 5, "result.done": 22, "result.overdue": 4, "result.access_ready": 2, "result.revoke_due": 2}}},
    {"id": "no-status-file", "tool": "eos_status", "args": {"people": "fixtures/people.csv", "template": "fixtures/template.json", "as_of": "2026-11-14"}, "expect": {"equals": {"result.done": 0, "result.revoke_due": 0}, "not_contains": ["access_before_prereqs"]}},
    {"id": "drafts-auto-when-opted-in", "tool": "eos_draft_access_requests", "mode": "auto", "auto_actions": ["eos_draft_access_requests"], "args": {"people": "fixtures/people.csv", "template": "fixtures/template.json", "status": "fixtures/status.csv", "as_of": "2026-11-14", "out_dir": "mythos-out/eval"}, "expect": {"status": "executed", "contains": ["4 access draft(s) written (2 grant, 2 removal). Nothing was submitted or changed."]}},
    {"id": "grant-stays-one-click-in-auto", "tool": "eos_request_access_grant", "mode": "auto", "args": {"people": "p.csv", "template": "t.json", "person_id": "C1", "task_id": "email"}, "expect": {"status": "needs_approval", "contains": ["go_live stays one-click"]}},
    {"id": "removal-stays-one-click-in-auto", "tool": "eos_request_access_removal", "mode": "auto", "args": {"people": "p.csv", "template": "t.json", "person_id": "C3", "task_id": "repo", "reason": "ended"}, "expect": {"status": "needs_approval", "contains": ["revoke_access stays one-click"]}},
    {"id": "never-touches-idp", "tool": "idp_grant_access", "mode": "auto", "args": {}, "expect": {"status": "blocked", "contains": ["never grants access"]}},
    {"id": "role-templates", "tool": "eos_status", "args": {"people": "fixtures/people.csv", "template": "fixtures/template-roles.json", "status": "fixtures/status.csv", "as_of": "2026-11-14"}, "expect": {"contains": ["unknown_role", "access_outside_role", "\"role_template\":\"Front-end developer\"", "\"task_id\":\"ci\""], "equals": {"result.tasks": 34}}},
    {"id": "offboarding-mirror", "tool": "eos_offboarding", "args": {"people": "fixtures/people.csv", "template": "fixtures/template.json", "status": "fixtures/status.csv", "as_of": "2026-11-14"}, "expect": {"contains": ["remove-email", "remove-repo", "return-laptop", "access_removal_overdue"], "equals": {"result.people": 1, "result.removals_overdue": 2, "result.returns_open": 0}}},
    {"id": "offboarding-drafts-auto", "tool": "eos_draft_offboarding", "mode": "auto", "auto_actions": ["eos_draft_offboarding"], "args": {"people": "fixtures/people.csv", "template": "fixtures/template.json", "status": "fixtures/status.csv", "as_of": "2026-11-14", "out_dir": "mythos-out/eval-off"}, "expect": {"status": "executed", "contains": ["1 offboarding checklist(s) and 2 removal draft(s) written. Nothing was submitted or changed."]}},
    {"id": "offboarding-drafts-ask-in-assist", "tool": "eos_draft_offboarding", "args": {"people": "fixtures/people.csv", "template": "fixtures/template.json", "status": "fixtures/status.csv", "as_of": "2026-11-14", "out_dir": "mythos-out/eval-off2"}, "expect": {"status": "needs_approval"}},
    {"id": "owner-actions", "tool": "eos_owner_actions", "args": {"people": "fixtures/people.csv", "template": "fixtures/template.json", "status": "fixtures/status.csv", "as_of": "2026-11-14"}, "expect": {"equals": {"result.items.0.task_id": "remove-email", "result.actions": 14}, "contains": ["needed before Jordan Lee starts on 2026-11-16"]}},
    {"id": "readiness-report-hashed", "tool": "eos_readiness_report", "args": {"people": "fixtures/people.csv", "template": "fixtures/template.json", "status": "fixtures/status.csv", "as_of": "2026-11-14", "out_dir": "mythos-out/eval-ready"}, "expect": {"status": "executed", "matches": ["\"output_sha256\":\"[0-9a-f]{64}\""], "contains": ["0 of 1 ready for day one", "Statement of work signed: overdue"]}},
    {"id": "template-typo-fails-with-pointer", "tool": "eos_status", "args": {"people": "fixtures/people.csv", "template": "fixtures/bad-template-typo.json", "status": "fixtures/status.csv", "as_of": "2026-11-14"}, "expect": {"status": "error", "contains": ["/types/contractor/0/requries is not an allowed property"]}}
  ]
}
