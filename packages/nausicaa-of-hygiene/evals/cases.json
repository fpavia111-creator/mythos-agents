{
  "suite": "nausicaa-of-hygiene",
  "root": "..",
  "data_note": "Fictional contacts in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {"id": "audit-flags", "tool": "nausicaa_audit", "args": {"contacts": "fixtures/contacts.csv", "suppression": "fixtures/suppression.csv", "as_of": "2026-11-14"}, "expect": {"contains": ["role_address", "domain_typo_gmail.com", "hard_bounce", "consent_conflict_unsubscribed", "duplicate_of_C1", "disposable_domain", "invalid_email", "on_suppression_list"], "equals": {"result.contacts": 10, "result.keep": 1, "result.delete_candidates": 1, "result.merge": 1}}},
    {"id": "no-suppression-list", "tool": "nausicaa_audit", "args": {"contacts": "fixtures/contacts.csv", "as_of": "2026-11-14"}, "expect": {"not_contains": ["on_suppression_list"]}},
    {"id": "clean-copy-auto-when-opted-in", "tool": "nausicaa_write_clean_copy", "mode": "auto", "auto_actions": ["nausicaa_write_clean_copy"], "args": {"contacts": "fixtures/contacts.csv", "as_of": "2026-11-14", "out_dir": "mythos-out/eval"}, "expect": {"status": "executed", "contains": ["all 10 row(s) kept"]}},
    {"id": "clean-copy-asks-in-assist", "tool": "nausicaa_write_clean_copy", "args": {"contacts": "fixtures/contacts.csv"}, "expect": {"status": "needs_approval"}},
    {"id": "bulk-delete-stays-one-click-in-auto", "tool": "nausicaa_request_bulk_delete", "mode": "auto", "args": {"ids": ["C4"], "reason": "bounced"}, "expect": {"status": "needs_approval", "decision": "ask"}},
    {"id": "never-deletes-in-crm", "tool": "crm_delete_contacts", "mode": "auto", "args": {}, "expect": {"status": "blocked"}},
    {"id": "health-score-explained", "tool": "nausicaa_audit", "args": {"contacts": "fixtures/contacts.csv", "suppression": "fixtures/suppression.csv", "as_of": "2026-11-14"}, "expect": {"equals": {"result.health.score": 18}, "contains": ["\"area\":\"deliverability\"", "weight 1 = 50 point(s)"]}},
    {"id": "merge-plan-rules", "tool": "nausicaa_merge_plan", "args": {"contacts": "fixtures/contacts.csv", "as_of": "2026-11-14", "out_dir": "mythos-out/eval"}, "expect": {"equals": {"result.groups": 1, "result.plan.0.survivor_id": "C1", "result.plan.0.merge_ids": ["C6"]}, "contains": ["S2: most recent activity", "F5 consent fields", "merge-plan.csv"]}},
    {"id": "consent-provenance-flags", "tool": "nausicaa_consent_provenance", "args": {"contacts": "fixtures/contacts.csv", "as_of": "2026-11-14", "rules": "fixtures/hygiene-rules.json"}, "expect": {"equals": {"result.source_missing": 3, "result.date_missing": 1, "result.source_not_allowed": 1, "result.complete": 5}}},
    {"id": "compare-previous-export", "tool": "nausicaa_compare", "args": {"previous": "fixtures/contacts-previous.csv", "contacts": "fixtures/contacts.csv", "suppression": "fixtures/suppression.csv", "as_of": "2026-11-14", "previous_as_of": "2026-10-14"}, "expect": {"equals": {"result.added": 2, "result.removed": 1, "result.newly_flagged": 3}, "contains": ["consent_conflict_unsubscribed", "hard_bounce"]}},
    {"id": "mx-check-asks-in-assist", "tool": "nausicaa_check_mx", "args": {"contacts": "fixtures/mx-contacts.csv", "records": "fixtures/mx-records.json"}, "expect": {"status": "needs_approval", "decision": "ask"}},
    {"id": "mx-check-blocked-in-review", "tool": "nausicaa_check_mx", "mode": "review", "args": {"contacts": "fixtures/mx-contacts.csv", "allow_network": true}, "expect": {"status": "blocked"}},
    {"id": "mx-check-offline-records", "tool": "nausicaa_check_mx", "mode": "auto", "auto_actions": ["nausicaa_check_mx"], "args": {"contacts": "fixtures/mx-contacts.csv", "records": "fixtures/mx-records.json", "out_dir": "mythos-out/eval"}, "expect": {"status": "executed", "contains": ["domain_not_found", "no_mail_host", "no_mx_implicit_a", "records file"]}},
    {"id": "mx-check-refuses-without-opt-in", "tool": "nausicaa_check_mx", "mode": "auto", "auto_actions": ["nausicaa_check_mx"], "args": {"contacts": "fixtures/mx-contacts.csv"}, "expect": {"status": "error", "contains": ["Off by default"]}}
  ]
}
