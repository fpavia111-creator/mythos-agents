{
  "openapi": "3.0.3",
  "info": { "title": "Ladle Recipes API (fictional)", "version": "1.4.0" },
  "servers": [{ "url": "https://api.example.com/v1" }],
  "paths": {
    "/recipes": {
      "get": { "operationId": "listRecipes", "responses": { "200": { "description": "ok" } } },
      "post": { "operationId": "createRecipe", "responses": { "201": { "description": "created" } } }
    },
    "/recipes/{recipeId}": {
      "get": { "operationId": "getRecipe", "responses": { "200": { "description": "ok" } } },
      "put": { "operationId": "replaceRecipe", "responses": { "200": { "description": "ok" } } }
    },
    "/recipes/search": {
      "get": { "operationId": "searchRecipes", "deprecated": true, "responses": { "200": { "description": "ok" } } }
    }
  }
}
