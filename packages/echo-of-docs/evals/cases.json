{
  "suite": "echo-of-docs",
  "root": "..",
  "data_note": "Fictional pack ../fixtures/kettle-of-notes whose docs drift from its tools.json and package.json on purpose. Deterministic; no model and no network are used.",
  "cases": [
    { "id": "planted-drift", "tool": "echo_check", "args": { "pack": "fixtures/kettle-of-notes", "tools": "fixtures/kettle-of-notes/tools.json" },
      "expect": { "status": "executed", "contains": ["tool_not_in_code", "policy_mismatch", "param_not_in_schema", "tool_undocumented", "version_mismatch", "engines_mismatch", "script_missing", "broken_link", "broken_anchor", "skill_frontmatter", "license_mismatch", "count_mismatch", "Did you mean `kettle_summarize`?"], "equals": { "result.issues": 19, "result.by_severity.error": 9, "result.tools": 5 } } },
    { "id": "one-click-undocumented", "tool": "echo_check", "args": { "pack": "fixtures/kettle-of-notes", "tools": "fixtures/kettle-of-notes/tools.json" }, "expect": { "contains": ["`kettle_request_publish` (ask, production_deploy) is in the tool list but not in any doc"] } },
    { "id": "without-tools-only-package-checks", "tool": "echo_check", "args": { "pack": "fixtures/kettle-of-notes" }, "expect": { "not_contains": ["tool_not_in_code", "policy_mismatch"], "contains": ["version_mismatch", "broken_link"] } },
    { "id": "drafts-auto-within-caps", "tool": "echo_draft_fixes", "mode": "auto", "auto_actions": ["echo_draft_fixes"], "args": { "pack": "fixtures/kettle-of-notes", "tools": "fixtures/kettle-of-notes/tools.json", "max_fixes": 2, "out_dir": "mythos-out/eval" }, "expect": { "status": "executed", "contains": ["2 mechanical fix(es)", "1 skipped by the caps", "Your docs were not changed."] } },
    { "id": "publish-stays-one-click-in-auto", "tool": "echo_request_publish", "mode": "auto", "args": { "proposal": "x.json", "proposal_sha256": "0" }, "expect": { "status": "needs_approval", "contains": ["production_deploy stays one-click"] } },
    { "id": "never-overwrites", "tool": "write_docs", "mode": "auto", "args": {}, "expect": { "status": "blocked", "contains": ["never overwrites docs"] } },
    { "id": "missing-pack-errors", "tool": "echo_check", "args": { "pack": "fixtures/nope" }, "expect": { "status": "error", "contains": ["pack folder not found"] } }
  ]
}
