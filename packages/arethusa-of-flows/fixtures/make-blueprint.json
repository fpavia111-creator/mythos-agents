{
  "name": "Refund approvals",
  "flow": [
    { "id": 1, "module": "gateway:CustomWebHook", "parameters": { "hook": 1001 } },
    { "id": 2, "module": "builtin:BasicRouter", "routes": [
      { "flow": [
        { "id": 3, "module": "paypal:createRefund", "parameters": {}, "mapper": { "amount": "{{1.amount}}" } },
        { "id": 4, "module": "http:ActionSendData", "mapper": { "url": "https://api.example.com/refunds", "headers": [{ "name": "X-API-Key", "value": "FAKE-demo-api-key-9999" }] } }
      ] }
    ] }
  ],
  "metadata": { "version": 1 }
}
