{
  "suite": "arethusa-of-flows",
  "root": "..",
  "data_note": "Fictional workflow exports and run history in ../fixtures; secret-looking values are FAKE placeholders. Deterministic checks; no model is called.",
  "cases": [
    { "id": "n8n-orders-findings", "tool": "arethusa_audit", "args": { "exports": ["fixtures/n8n-orders.json"], "history": "fixtures/run-history.csv", "as_of": "2026-11-14T12:00:00Z" },
      "expect": { "contains": ["open_webhook", "hardcoded_secret", "money_moving", "failing_runs", "disconnected_step", "plain_http", "disabled_step", "no_error_handler"], "not_contains": ["FAKE"], "equals": { "result.flows": 1, "result.high": 4 } } },
    { "id": "delete-without-filter", "tool": "arethusa_audit", "args": { "exports": ["fixtures/n8n-cleanup.json"] }, "expect": { "contains": ["destructive_without_filter", "\"code\":\"destructive_step\",\"step\":\"Remove from list\"", "code_exec"], "not_contains": ["no_error_handler"] } },
    { "id": "zapier-and-make", "tool": "arethusa_audit", "args": { "exports": ["fixtures/zapier-export.json", "fixtures/make-blueprint.json"] }, "expect": { "contains": ["no_trigger", "sends_messages", "open_webhook"], "not_contains": ["FAKE"], "equals": { "result.flows": 4, "result.active": 3 } } },
    { "id": "drafts-auto-when-opted-in", "tool": "arethusa_draft_changes", "mode": "auto", "auto_actions": ["arethusa_draft_changes"], "args": { "exports": ["fixtures/make-blueprint.json"], "out_dir": "mythos-out/eval" }, "expect": { "status": "executed", "contains": ["Nothing was applied"] } },
    { "id": "flow-change-stays-one-click-in-auto", "tool": "arethusa_request_flow_change", "mode": "auto", "args": { "flow": "Order sync", "change": "enable", "detail": "fixed" }, "expect": { "status": "needs_approval", "contains": ["production_deploy stays one-click"] } },
    { "id": "never-runs-flows", "tool": "automation_run_flow", "mode": "auto", "args": {}, "expect": { "status": "blocked" } }
  ]
}
