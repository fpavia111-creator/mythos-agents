{
  "suite": "arethusa-of-flows",
  "root": "..",
  "data_note": "Fictional workflow exports and run history in ../fixtures; secret-looking values are FAKE placeholders. Deterministic checks; no model is called.",
  "cases": [
    {"id": "n8n-orders-findings", "tool": "arethusa_audit", "args": {"exports": ["fixtures/n8n-orders.json"], "history": "fixtures/run-history.csv", "as_of": "2026-11-14T12:00:00Z"}, "expect": {"contains": ["open_webhook", "hardcoded_secret", "money_moving", "failing_runs", "disconnected_step", "plain_http", "disabled_step", "no_error_handler"], "not_contains": ["FAKE"], "equals": {"result.flows": 1, "result.high": 4}}},
    {"id": "delete-without-filter", "tool": "arethusa_audit", "args": {"exports": ["fixtures/n8n-cleanup.json"]}, "expect": {"contains": ["destructive_without_filter", "\"code\":\"destructive_step\",\"step\":\"Remove from list\"", "code_exec"], "not_contains": ["no_error_handler"]}},
    {"id": "zapier-and-make", "tool": "arethusa_audit", "args": {"exports": ["fixtures/zapier-export.json", "fixtures/make-blueprint.json"]}, "expect": {"contains": ["no_trigger", "sends_messages", "open_webhook"], "not_contains": ["FAKE"], "equals": {"result.flows": 4, "result.active": 3}}},
    {"id": "power-automate-checks", "tool": "arethusa_audit", "args": {"exports": ["fixtures/power-automate-flow.json"]}, "expect": {"contains": ["power_automate", "open_webhook", "hardcoded_secret", "possible_secret", "destructive_without_filter", "sends_messages", "disconnected_step"], "not_contains": ["FAKE"], "equals": {"result.flows": 1, "result.high": 3}}},
    {"id": "workato-checks", "tool": "arethusa_audit", "args": {"exports": ["fixtures/workato-recipes.json"]}, "expect": {"contains": ["\"platform\":\"workato\"", "money_moving", "GitHub token", "Stripe test secret key", "\"code\":\"destructive_step\""], "not_contains": ["FAKE", "destructive_without_filter"], "equals": {"result.flows": 2, "result.active": 1}}},
    {"id": "policy-suppression", "tool": "arethusa_audit", "args": {"exports": ["fixtures/power-automate-flow.json"], "policy": "fixtures/arethusa-policy.json", "as_of": "2026-11-14T12:00:00Z"}, "expect": {"status": "executed", "contains": ["correlation id"], "length": {"result.suppressed": 1}}},
    {"id": "policy-schema-error", "tool": "arethusa_audit", "args": {"exports": ["fixtures/power-automate-flow.json"], "policy": "fixtures/make-blueprint.json"}, "expect": {"status": "error", "contains": ["not a valid policy", "/name is not an allowed property"]}},
    {"id": "dependency-map", "tool": "arethusa_dependency_map", "args": {"exports": ["fixtures/n8n-orders.json", "fixtures/make-blueprint.json", "fixtures/power-automate-flow.json", "fixtures/workato-recipes.json"], "out_dir": "mythos-out/eval"}, "expect": {"status": "executed", "decision": "allow", "contains": ["n8n webhook /orders-in", "workato stripe: Stripe production", "rotation_plan"], "not_contains": ["FAKE"], "length": {"result.calls": 1}, "equals": {"result.shared": 3, "result.rotation_plan.0.priority": "P1"}}},
    {"id": "report-with-sarif", "tool": "arethusa_write_report", "args": {"exports": ["fixtures/power-automate-flow.json", "fixtures/workato-recipes.json"], "out_dir": "mythos-out/eval"}, "expect": {"status": "executed", "contains": ["findings.sarif"], "matches": ["\"output_sha256\":\"[0-9a-f]{64}\""]}},
    {"id": "drafts-auto-when-opted-in", "tool": "arethusa_draft_changes", "mode": "auto", "auto_actions": ["arethusa_draft_changes"], "args": {"exports": ["fixtures/make-blueprint.json"], "out_dir": "mythos-out/eval"}, "expect": {"status": "executed", "contains": ["Nothing was applied"]}},
    {"id": "flow-change-stays-one-click-in-auto", "tool": "arethusa_request_flow_change", "mode": "auto", "args": {"flow": "Order sync", "change": "enable", "detail": "fixed"}, "expect": {"status": "needs_approval", "contains": ["production_deploy stays one-click"]}},
    {"id": "never-runs-flows", "tool": "automation_run_flow", "mode": "auto", "args": {}, "expect": {"status": "blocked"}}
  ]
}
