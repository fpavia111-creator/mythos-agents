{
  "suite": "urania-of-flux",
  "root": "..",
  "data_note": "Fictional company figures and board documents in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {"id": "variance-materiality", "tool": "urania_variance", "args": {"figures": "fixtures/figures.csv", "out_dir": "mythos-out/eval-none"}, "expect": {"contains": ["\"basis\":\"prior\"", "lock: none"], "equals": {"result.figures.0.var_budget": 134000, "result.figures.4.material": true, "result.figures.3.material": false}}},
    {"id": "claims-check", "tool": "urania_check_claims", "args": {"figures": "fixtures/figures.csv", "docs": ["fixtures/docs/ceo-letter.md", "fixtures/docs/ops-update.md"]}, "expect": {"contains": ["312,000", "F9"], "equals": {"result.ok": 5, "result.uncited_number": 1, "result.unknown_citation": 1, "result.number_mismatch": 1}}},
    {"id": "assemble-refuses-without-lock", "tool": "urania_assemble_pack", "args": {"figures": "fixtures/figures.csv", "docs": ["fixtures/docs/ceo-letter.md"], "out_dir": "mythos-out/eval-none"}, "expect": {"status": "error", "contains": ["lock the figures first"]}},
    {"id": "lock-auto-when-opted-in", "tool": "urania_lock_figures", "mode": "auto", "auto_actions": ["urania_lock_figures"], "args": {"figures": "fixtures/figures.csv", "out_dir": "mythos-out/eval"}, "expect": {"status": "executed", "equals": {"result.rows": 6}}},
    {"id": "percent-direction-ratio-claims", "tool": "urania_check_claims", "args": {"figures": "fixtures/figures.csv", "docs": ["fixtures/docs/cfo-notes.md"]}, "expect": {"contains": ["F3/F1.ratio", "wrong direction"], "equals": {"result.ok": 3, "result.direction_mismatch": 1, "result.claims.2.wrong_direction": ["5,000"]}}},
    {"id": "compare-prior-restatements", "tool": "urania_compare_prior", "args": {"figures": "fixtures/figures.csv", "prior_figures": "fixtures/prior/figures-2026-09.csv", "prior_manifest": "fixtures/prior/pack-manifest-2026-09.json", "docs": ["fixtures/docs/ops-update.md"]}, "expect": {"status": "executed", "equals": {"result.prior_restated": 2, "result.affected_ids": ["F2", "F3"], "result.dropped_metrics": 1, "result.prior_pack.figures_match_manifest": true}, "length": {"result.impact": 2}}},
    {"id": "compare-prior-missing-manifest", "tool": "urania_compare_prior", "args": {"figures": "fixtures/figures.csv", "prior_figures": "fixtures/prior/figures-2026-09.csv", "prior_manifest": "fixtures/figures.lock.json"}, "expect": {"status": "error", "contains": ["file not found"]}},
    {"id": "charts-trace-to-figure-ids", "tool": "urania_charts", "args": {"figures": "fixtures/figures.csv", "out_dir": "mythos-out/eval", "charts": ["variance", "actual_vs_basis"]}, "expect": {"status": "executed", "decision": "allow", "matches": ["\"figure_id\":\"F6\",\"field\":\"var_prior\",\"value\":-160000"], "length": {"result.charts": 2, "result.charts.0.points": 6, "result.charts.1.points": 12}, "not_contains": ["<script"]}},
    {"id": "charts-refuse-without-lock", "tool": "urania_charts", "args": {"figures": "fixtures/figures.csv", "out_dir": "mythos-out/eval-none"}, "expect": {"status": "error", "contains": ["lock the figures first"]}},
    {"id": "html-pack", "tool": "urania_assemble_pack", "args": {"figures": "fixtures/figures.csv", "out_dir": "mythos-out/eval", "docs": ["fixtures/docs/cfo-notes.md"], "html": true}, "expect": {"status": "executed", "contains": ["board-pack.html"], "matches": ["\"output_sha256\":\"[0-9a-f]{64}\""]}},
    {"id": "signoff-stays-one-click-in-auto", "tool": "urania_record_signoff", "mode": "auto", "args": {"pack_manifest": "x.json", "pack_sha256": "x", "controller": "R"}, "expect": {"status": "needs_approval", "contains": ["binding_send stays one-click"]}},
    {"id": "distribution-stays-one-click-in-auto", "tool": "urania_request_distribution", "mode": "auto", "args": {"pack_manifest": "x.json", "pack_sha256": "x", "recipients": ["b@example.org"]}, "expect": {"status": "needs_approval"}},
    {"id": "never-uploads", "tool": "board_portal_upload", "mode": "auto", "args": {}, "expect": {"status": "blocked"}}
  ]
}
